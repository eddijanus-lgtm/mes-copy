NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=mes_admin
DB_PASSWORD=replace_with_a_strong_database_password
DB_DATABASE=mes_production

JWT_SECRET=replace_with_at_least_32_random_characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_at_least_12_random_characters
MES_BASE_URL=http://localhost:3000/api
DEMO_ADMIN_USERNAME=replace_with_local_admin
DEMO_ADMIN_PASSWORD=replace_with_local_admin_password

MQTT_BROKER_URL=mqtt://10.10.10.253:1883
MQTT_ALLOWED_TOPIC_PREFIXES=mes/,i4.0/
WEBSHOP_MQTT_TOPIC=i4.0/production/orders
OPC_UA_SERVER_ADDRESS=opc.tcp://localhost:4840/UA/WaraMesTest
OPC_UA_ALLOWED_NODE_PREFIXES=ns=1;s=Station
OPC_UA_RESOURCE_IDS=1,2,3
OPC_UA_TEST_SERVER_PORT=4840
MACHINE_PROFILE_PATH=

# --- Notifications (Phase 7) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TARGETS=admin@localhost
ALERT_MQTT_TOPIC=mes/alerts
ALERT_PUSH_SUBSCRIPTIONS=[]
NOTIFICATION_RULE_EVAL_INTERVAL_SEC=30
SEVERITY_FILTER=warning,error,critical
