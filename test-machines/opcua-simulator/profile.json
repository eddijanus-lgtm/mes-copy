{
  "profileVersion": "1.0",
  "machineId": "simulator",
  "displayName": "Simulator",
  "description": "External simulated OPC UA machine for development and testing",
  "transport": "opcua",
  "operatingMode": "control",
  "routing": {
    "terminalResourceId": 0
  },
  "connection": {
    "endpointUrl": "opc.tcp://localhost:4840/UA/WaraMesTest",
    "applicationName": "WaraSimulator",
    "security": {
      "mode": "None",
      "policy": "None"
    },
    "authentication": {
      "type": "anonymous"
    },
    "connectionTimeoutMs": 10000,
    "sessionTimeoutMs": 60000,
    "reconnect": {
      "enabled": true,
      "initialDelayMs": 1000,
      "maximumDelayMs": 30000,
      "backoffMultiplier": 2,
      "maxAttempts": 10
    }
  },
  "namespaces": [
    {
      "key": "station",
      "uri": "urn:wara:simulator"
    }
  ],
  "orderParameterDefinitions": [
    {
      "key": "iPar1",
      "sourceKey": "bDeckelfarbe",
      "signalKey": "parameter1",
      "required": true,
      "label": "Deckelfarbe",
      "type": "select",
      "default_value": 1,
      "options": [
        { "label": "Rot", "value": 1, "available_quantity": 80 },
        { "label": "Gruen", "value": 2, "available_quantity": 65 },
        { "label": "Blau", "value": 4, "available_quantity": 40 }
      ]
    },
    { "key": "iPar2", "sourceKey": "uiKugelRot", "signalKey": "parameter2", "required": true, "label": "Rote Kugeln", "type": "number", "default_value": 3, "min_value": 0, "max_value": 99, "unit": "Stk", "available_quantity": 200 },
    { "key": "iPar3", "sourceKey": "uiKugelGruen", "signalKey": "parameter3", "required": true, "label": "Gruene Kugeln", "type": "number", "default_value": 5, "min_value": 0, "max_value": 99, "unit": "Stk", "available_quantity": 150 },
    { "key": "iPar4", "sourceKey": "uiKugelBlau", "signalKey": "parameter4", "required": true, "label": "Blaue Kugeln", "type": "number", "default_value": 7, "min_value": 0, "max_value": 99, "unit": "Stk", "available_quantity": 90 }
  ],
  "resultCodes": {
    "0": "OK",
    "1": "Carrier unbekannt",
    "2": "Auftrag oder Schritt fehlt",
    "3": "Falsche Station",
    "4": "Bereits abgeschlossen",
    "9": "Interner Fehler"
  },
  "routingResultCodes": {
    "accepted": 0,
    "carrier_unknown": 1,
    "order_missing": 2,
    "wrong_resource": 3,
    "already_completed": 4,
    "internal_error": 9
