{
  "profileVersion": "1.0",
  "machineId": "YOUR_MACHINE_ID",
  "displayName": "YOUR_MACHINE_DISPLAY_NAME",
  "description": "Production template. Replace every YOUR_* value with commissioning results.",
  "transport": "opcua",
  "operatingMode": "control",
  "connection": {
    "endpointUrl": "opc.tcp://YOUR_ENDPOINT:4840",
    "applicationName": "YOUR_APPLICATION_NAME",
    "security": {
      "mode": "SignAndEncrypt",
      "policy": "Basic256Sha256",
      "certificatePathEnv": "OPCUA_CERTIFICATE_PATH",
      "privateKeyPathEnv": "OPCUA_PRIVATE_KEY_PATH"
    },
    "authentication": {
      "type": "username",
      "usernameEnv": "OPCUA_USERNAME",
      "passwordEnv": "OPCUA_PASSWORD"
    },
    "connectionTimeoutMs": 15000,
    "sessionTimeoutMs": 120000,
    "reconnect": {
      "enabled": true,
      "initialDelayMs": 2000,
      "maximumDelayMs": 60000,
      "backoffMultiplier": 2,
      "maxAttempts": 0
    }
  },
  "namespaces": [
    {
      "key": "main",
      "uri": "YOUR_NAMESPACE_URI"
    }
  ],
  "stations": [
    {
      "stationId": "YOUR_STATION_ID",
      "resourceId": 1,
      "displayName": "YOUR_STATION_DISPLAY_NAME",
      "description": "Replace identifiers with the nodes discovered during commissioning.",
      "enabled": true,
      "routing": {
        "sequence": 1,
        "operationNo": 10,
        "operation": "YOUR_OPERATION_NAME"
      },
      "signals": [
        { "key": "request", "role": "workRequest", "direction": "machineToMes", "namespace": "main", "identifier": "YOUR_WORK_REQUEST_IDENTIFIER", "dataType": "Boolean", "access": "read", "required": true, "event": { "trigger": "change" } },
        { "key": "requestCarrier", "role": "carrierId", "direction": "machineToMes", "namespace": "main", "identifier": "YOUR_REQUEST_CARRIER_IDENTIFIER", "dataType": "UInt32", "access": "read", "required": true },
        { "key": "requestedResource", "role": "resourceId", "direction": "machineToMes", "namespace": "main", "identifier": "YOUR_RESOURCE_IDENTIFIER", "dataType": "UInt16", "access": "read", "required": true },
        { "key": "busyResponse", "role": "requestBusy", "direction": "mesToMachine", "namespace": "main", "identifier": "YOUR_BUSY_IDENTIFIER", "dataType": "Boolean", "access": "write", "required": true },
        { "key": "acceptedResponse", "role": "requestAccepted", "direction": "mesToMachine", "namespace": "main", "identifier": "YOUR_ACCEPTED_IDENTIFIER", "dataType": "Boolean", "access": "write", "required": true },
        { "key": "rejectedResponse", "role": "requestRejected", "direction": "mesToMachine", "namespace": "main", "identifier": "YOUR_REJECTED_IDENTIFIER", "dataType": "Boolean", "access": "write", "required": true },
        { "key": "orderNumber", "role": "orderId", "direction": "mesToMachine", "namespace": "main", "identifier": "YOUR_ORDER_IDENTIFIER", "dataType": "String", "access": "write", "required": true },
        { "key": "partNumber", "role": "partNumber", "direction": "mesToMachine", "namespace": "main", "identifier": "YOUR_PART_IDENTIFIER", "dataType": "String", "access": "write", "required": true },
        { "key": "operationNumber", "role": "operationId", "direction": "mesToMachine", "namespace": "main", "identifier": "YOUR_OPERATION_IDENTIFIER", "dataType": "UInt16", "access": "write", "required": true },
        { "key": "routeStep", "role": "stepNumber", "direction": "mesToMachine", "namespace": "main", "identifier": "YOUR_STEP_IDENTIFIER", "dataType": "UInt16", "access": "write", "required": true },
        { "key": "nextResource", "role": "nextStationId", "direction": "mesToMachine", "namespace": "main", "identifier": "YOUR_NEXT_RESOURCE_IDENTIFIER", "dataType": "UInt16", "access": "write", "required": true },
        { "key": "result", "role": "processResult", "direction": "mesToMachine", "namespace": "main", "identifier": "YOUR_RESULT_IDENTIFIER", "dataType": "UInt16", "access": "write", "required": true },
        { "key": "processBusy", "role": "processActive", "direction": "machineToMes", "namespace": "main", "identifier": "YOUR_PROCESS_ACTIVE_IDENTIFIER", "dataType": "Boolean", "access": "read", "required": true },
        { "key": "completedCarrier", "role": "completedCarrierId", "direction": "machineToMes", "namespace": "main", "identifier": "YOUR_COMPLETED_CARRIER_IDENTIFIER", "dataType": "UInt32", "access": "read", "required": true },
        { "key": "completion", "role": "processCompleted", "direction": "machineToMes", "namespace": "main", "identifier": "YOUR_PROCESS_COMPLETED_IDENTIFIER", "dataType": "Boolean", "access": "read", "required": true, "event": { "trigger": "rising" } },
        { "key": "startCommand", "role": "controlStart", "direction": "mesToMachine", "namespace": "main", "identifier": "YOUR_START_IDENTIFIER", "dataType": "Boolean", "access": "write", "required": false },
        { "key": "stopCommand", "role": "controlStop", "direction": "mesToMachine", "namespace": "main", "identifier": "YOUR_STOP_IDENTIFIER", "dataType": "Boolean", "access": "write", "required": false },
        { "key": "resetCommand", "role": "controlReset", "direction": "mesToMachine", "namespace": "main", "identifier": "YOUR_RESET_IDENTIFIER", "dataType": "Boolean", "access": "write", "required": false },
        { "key": "pauseCommand", "role": "controlPause", "direction": "mesToMachine", "namespace": "main", "identifier": "YOUR_PAUSE_IDENTIFIER", "dataType": "Boolean", "access": "write", "required": false }
      ],
      "metadata": {
        "location": "YOUR_LINE_OR_LOCATION",
        "machineType": "YOUR_MACHINE_TYPE"
      }
    }
  ],
  "resultCodes": {
    "0": "OK"
  },
  "metadata": {
    "manufacturer": "YOUR_MANUFACTURER",
    "model": "YOUR_MODEL",
    "version": "YOUR_VERSION"
  }
}
