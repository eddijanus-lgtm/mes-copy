{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wara.local/schema/machine-profile.schema.json",
  "title": "Machine Profile",
  "description": "Schema for WARA machine profile configuration files",
  "type": "object",
  "properties": {
    "profileVersion": {
      "type": "string"
    },
    "machineId": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "machineVersion": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "transport": {
      "type": "string",
      "enum": ["opcua"]
    },
    "operatingMode": {
      "type": "string",
      "enum": ["observe", "validate", "control"]
    },
    "connection": {
      "$ref": "#/$defs/connection"
    },
    "namespaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namespace"
      },
      "minItems": 1
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terminalResourceId": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["terminalResourceId"]
    },
    "stations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/station"
      },
      "minItems": 1
    },
    "orderParameterDefinitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/orderParameterDefinition"
      }
    },
    "resultCodes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "routingResultCodes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted": { "type": "integer", "minimum": 0 },
        "carrier_unknown": { "type": "integer", "minimum": 0 },
        "order_missing": { "type": "integer", "minimum": 0 },
        "wrong_resource": { "type": "integer", "minimum": 0 },
        "already_completed": { "type": "integer", "minimum": 0 },
        "internal_error": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "accepted",
        "carrier_unknown",
        "order_missing",
        "wrong_resource",
        "already_completed",
        "internal_error"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "profileVersion",
    "machineId",
    "displayName",
    "transport",
    "operatingMode",
    "connection",
    "namespaces",
    "stations"
  ],
  "additionalProperties": false,
  "$defs": {
    "connection": {
      "type": "object",
      "properties": {
        "endpointUrl": {
          "type": "string",
          "minLength": 1
        },
        "applicationName": {
          "type": "string",
          "minLength": 1
        },
        "security": {
          "$ref": "#/$defs/security"
        },
        "authentication": {
          "$ref": "#/$defs/authentication"
        },
        "connectionTimeoutMs": {
          "type": "number"
        },
        "sessionTimeoutMs": {
          "type": "number"
        },
        "reconnect": {
          "$ref": "#/$defs/reconnect"
        }
      },
      "required": [
        "endpointUrl",
        "applicationName",
        "security",
        "authentication",
        "connectionTimeoutMs",
        "sessionTimeoutMs",
        "reconnect"
      ],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["None", "Sign", "SignAndEncrypt"]
        },
        "policy": {
          "type": "string",
          "enum": [
            "None",
            "Basic256Sha256",
            "Aes128_Sha256_RsaOaep",
            "Aes256_Sha256_RsaPss"
          ]
        },
        "certificatePathEnv": {
          "type": "string"
        },
        "privateKeyPathEnv": {
          "type": "string"
        }
      },
      "required": ["mode", "policy"],
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["anonymous", "username", "certificate"]
        },
        "usernameEnv": {
          "type": "string"
        },
        "passwordEnv": {
          "type": "string"
        },
        "certificatePathEnv": {
          "type": "string"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "reconnect": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelayMs": {
          "type": "number"
        },
        "maximumDelayMs": {
          "type": "number"
        },
        "backoffMultiplier": {
          "type": "number"
        },
        "maxAttempts": {
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "initialDelayMs",
        "maximumDelayMs",
        "backoffMultiplier"
      ],
      "additionalProperties": false
    },
    "namespace": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["key", "uri"],
      "additionalProperties": false
    },
    "station": {
      "type": "object",
      "properties": {
        "stationId": {
          "type": "string",
          "minLength": 1
        },
        "resourceId": {
          "type": "integer",
          "minimum": 1
        },
        "parentResourceId": {
          "type": "integer",
          "minimum": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "equipmentLevel": {
          "type": "string",
          "enum": ["machine", "work_unit", "component"]
        },
        "executionModel": {
          "type": "string",
          "enum": ["machine_job", "work_unit_jobs"]
        },
        "jobInterface": {
          "type": "string",
          "enum": ["signal_handshake", "job_control", "telemetry_only"]
        },
        "resourceType": {
          "type": "string",
          "enum": ["production", "inventory", "storage", "hybrid"]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["production", "routing", "control", "inventory", "storage", "telemetry"]
          },
          "uniqueItems": true
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          },
          "minItems": 1
        },
        "routing": {
          "$ref": "#/$defs/stationRouting"
        },
        "inventory": {
          "$ref": "#/$defs/carrierInventory"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "connection": {
          "$ref": "#/$defs/connection"
        }
      },
      "required": [
        "stationId",
        "resourceId",
        "displayName",
        "enabled",
        "resourceType",
        "signals"
      ],
      "additionalProperties": false
    },
    "carrierInventory": {
      "type": "object",
      "properties": {
        "validSignalKey": { "type": "string", "minLength": 1 },
        "revisionSignalKey": { "type": "string", "minLength": 1 },
        "capacitySignalKey": { "type": "string", "minLength": 1 },
        "availableCountSignalKey": { "type": "string", "minLength": 1 },
        "totalCountSignalKey": { "type": "string", "minLength": 1 },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/carrierInventorySlot" }
        }
      },
      "required": [
        "validSignalKey",
        "revisionSignalKey",
        "availableCountSignalKey",
        "totalCountSignalKey",
        "slots"
      ],
      "additionalProperties": false
    },
    "carrierInventorySlot": {
      "type": "object",
      "properties": {
        "slotId": { "type": "string", "minLength": 1 },
        "presentSignalKey": { "type": "string", "minLength": 1 },
        "carrierIdSignalKey": { "type": "string", "minLength": 1 },
        "rfidUidSignalKey": { "type": "string", "minLength": 1 },
        "rfidReadValidSignalKey": { "type": "string", "minLength": 1 },
        "physicalStateSignalKey": { "type": "string", "minLength": 1 },
        "readerIdSignalKey": { "type": "string", "minLength": 1 },
        "lastSeenSignalKey": { "type": "string", "minLength": 1 }
      },
      "required": ["slotId", "presentSignalKey"],
      "anyOf": [
        { "required": ["carrierIdSignalKey"] },
        { "required": ["rfidUidSignalKey"] }
      ],
      "additionalProperties": false
    },
    "stationRouting": {
      "type": "object",
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "operationNo": { "type": "integer", "minimum": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" }
      },
      "required": ["sequence", "operationNo", "operation"],
      "additionalProperties": false
    },
    "orderParameterDefinition": {
      "type": "object",
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "sourceKey": { "type": "string", "minLength": 1 },
        "signalKey": { "type": "string", "minLength": 1 },
        "targetResourceIds": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "required": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["number", "select"] },
        "default_value": { "type": "number" },
        "min_value": { "type": "number" },
        "max_value": { "type": "number" },
        "unit": { "type": "string" },
        "available_quantity": { "type": "number" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/orderParameterOption" }
        }
      },
      "required": ["key", "label", "type"],
      "additionalProperties": false
    },
    "orderParameterOption": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "available_quantity": { "type": "number" }
      },
      "required": ["label", "value"],
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "workRequest",
            "requestBusy",
            "requestAccepted",
            "requestRejected",
            "requestCompleted",
            "carrierId",
            "resourceId",
            "orderId",
            "partNumber",
            "operationId",
            "stepNumber",
            "nextStationId",
            "processActive",
            "processCompleted",
            "processResult",
            "timestamp",
            "completedCarrierId",
            "routingParameter",
            "controlStart",
            "controlStop",
            "controlReset",
            "controlPause",
            "inventoryValid",
            "inventoryRevision",
            "inventoryCapacity",
            "availableCarrierCount",
            "totalCarrierCount",
            "idealCycleTimeMs",
            "goodCount",
            "rejectCount",
            "slotOccupied",
            "slotId",
            "rfidUid",
            "rfidReadValid",
            "carrierPhysicalState",
            "carrierReaderId",
            "carrierLastSeen",
            "custom"
          ]
        },
        "direction": {
          "type": "string",
          "enum": ["machineToMes", "mesToMachine"]
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "dataType": {
          "type": "string",
          "enum": [
            "Boolean",
            "Byte",
            "UInt16",
            "UInt32",
            "Int16",
            "Int32",
            "Float",
            "Double",
            "String",
            "DateTime"
          ]
        },
        "access": {
          "type": "string",
          "enum": ["read", "write", "readWrite"]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "scaling": {
          "$ref": "#/$defs/scaling"
        },
        "event": {
          "$ref": "#/$defs/signalEvent"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "key",
        "role",
        "direction",
        "namespace",
        "identifier",
        "dataType",
        "access",
        "required"
      ],
      "additionalProperties": false
    },
    "signalEvent": {
      "type": "object",
      "properties": {
        "trigger": {
          "type": "string",
          "enum": ["change", "rising", "falling"]
        }
      },
      "required": ["trigger"],
      "additionalProperties": false
    },
    "scaling": {
      "type": "object",
      "properties": {
        "factor": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        }
      },
      "required": ["factor", "offset"],
      "additionalProperties": false
    },
    "envReference": {
      "type": "object",
      "properties": {
        "env": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": ["env"],
      "additionalProperties": false
    }
  }
}
