{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wara.local/schema/machine-profile.schema.json",
  "title": "Machine Profile",
  "description": "Schema for WARA machine profile configuration files",
  "type": "object",
  "properties": {
    "profileVersion": {
      "type": "string"
    },
    "machineId": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "transport": {
      "type": "string",
      "enum": ["opcua"]
    },
    "operatingMode": {
      "type": "string",
      "enum": ["observe", "validate", "control"]
    },
    "connection": {
      "$ref": "#/$defs/connection"
    },
    "namespaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namespace"
      },
      "minItems": 1
    },
    "stations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/station"
      },
      "minItems": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "profileVersion",
    "machineId",
    "displayName",
    "transport",
    "operatingMode",
    "connection",
    "namespaces",
    "stations"
  ],
  "additionalProperties": false,
  "$defs": {
    "connection": {
      "type": "object",
      "properties": {
        "endpointUrl": {
          "type": "string",
          "minLength": 1
        },
        "applicationName": {
          "type": "string",
          "minLength": 1
        },
        "security": {
          "$ref": "#/$defs/security"
        },
        "authentication": {
          "$ref": "#/$defs/authentication"
        },
        "connectionTimeoutMs": {
          "type": "number"
        },
        "sessionTimeoutMs": {
          "type": "number"
        },
        "reconnect": {
          "$ref": "#/$defs/reconnect"
        }
      },
      "required": [
        "endpointUrl",
        "applicationName",
        "security",
        "authentication",
        "connectionTimeoutMs",
        "sessionTimeoutMs",
        "reconnect"
      ],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["None", "Sign", "SignAndEncrypt"]
        },
        "policy": {
          "type": "string",
          "enum": ["None", "Basic256Sha256", "Aes128_Sha256_RsaOaep", "Aes256_Sha256_RsaPss"]
        },
        "certificatePathEnv": {
          "type": "string"
        },
        "privateKeyPathEnv": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "policy"
      ],
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["anonymous", "username", "certificate"]
        },
        "usernameEnv": {
          "type": "string"
        },
        "passwordEnv": {
          "type": "string"
        },
        "certificatePathEnv": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "reconnect": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelayMs": {
          "type": "number"
        },
        "maximumDelayMs": {
          "type": "number"
        },
        "backoffMultiplier": {
          "type": "number"
        },
        "maxAttempts": {
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "initialDelayMs",
        "maximumDelayMs",
        "backoffMultiplier"
      ],
      "additionalProperties": false
    },
    "namespace": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "uri"
      ],
      "additionalProperties": false
    },
    "station": {
      "type": "object",
      "properties": {
        "stationId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          },
          "minItems": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "stationId",
        "displayName",
        "enabled",
        "signals"
      ],
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "workRequest",
            "requestBusy",
            "requestAccepted",
            "requestRejected",
            "requestCompleted",
            "carrierId",
            "resourceId",
            "orderId",
            "partNumber",
            "operationId",
            "stepNumber",
            "nextStationId",
            "processActive",
            "processCompleted",
            "processResult",
            "timestamp",
            "custom"
          ]
        },
        "direction": {
          "type": "string",
          "enum": ["machineToMes", "mesToMachine"]
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "dataType": {
          "type": "string",
          "enum": [
            "Boolean",
            "Byte",
            "UInt16",
            "UInt32",
            "Int16",
            "Int32",
            "Float",
            "Double",
            "String",
            "DateTime"
          ]
        },
        "access": {
          "type": "string",
          "enum": ["read", "write", "readWrite"]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "scaling": {
          "$ref": "#/$defs/scaling"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "key",
        "role",
        "direction",
        "namespace",
        "identifier",
        "dataType",
        "access",
        "required"
      ],
      "additionalProperties": false
    },
    "scaling": {
      "type": "object",
      "properties": {
        "factor": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        }
      },
      "required": [
        "factor",
        "offset"
      ],
      "additionalProperties": false
    },
    "envReference": {
      "type": "object",
      "properties": {
        "env": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "env"
      ],
      "additionalProperties": false
    }
  }
}
