{
  "profileVersion": "1.0",
  "machineId": "YOUR_MACHINE_ID",
  "displayName": "YOUR_MACHINE_DISPLAY_NAME",
  "description": "Read-only commissioning profile. Replace all YOUR_* placeholders from the scan report.",
  "transport": "opcua",
  "operatingMode": "observe",
  "connection": {
    "endpointUrl": "opc.tcp://YOUR_MACHINE_HOST:4840/YOUR_RESOURCE_PATH",
    "applicationName": "WARA MES Commissioning",
    "security": {
      "mode": "None",
      "policy": "None"
    },
    "authentication": {
      "type": "anonymous"
    },
    "connectionTimeoutMs": 10000,
    "sessionTimeoutMs": 60000,
    "reconnect": {
      "enabled": true,
      "initialDelayMs": 1000,
      "maximumDelayMs": 30000,
      "backoffMultiplier": 2,
      "maxAttempts": 10
    }
  },
  "namespaces": [
    {
      "key": "machine",
      "uri": "YOUR_NAMESPACE_URI_FROM_SCAN"
    }
  ],
  "stations": [
    {
      "stationId": "YOUR_STATION_ID",
      "resourceId": 1,
      "displayName": "YOUR_STATION_DISPLAY_NAME",
      "description": "Start with only the read signals required for the dashboard.",
      "enabled": true,
      "resourceType": "production",
      "capabilities": ["production"],
      "signals": [
        {
          "key": "machineState",
          "role": "custom",
          "direction": "machineToMes",
          "namespace": "machine",
          "identifier": "YOUR_MACHINE_STATE_IDENTIFIER",
          "dataType": "Boolean",
          "access": "read",
          "required": true,
          "description": "Replace with the actual machine state signal from the scan."
        },
        {
          "key": "idealCycleTimeMs",
          "role": "idealCycleTimeMs",
          "direction": "machineToMes",
          "namespace": "machine",
          "identifier": "YOUR_IDEAL_CYCLE_TIME_IDENTIFIER",
          "dataType": "UInt32",
          "access": "read",
          "required": false,
          "description": "Ideal cycle time reported by the machine in milliseconds."
        },
        {
          "key": "goodCount",
          "role": "goodCount",
          "direction": "machineToMes",
          "namespace": "machine",
          "identifier": "YOUR_GOOD_COUNT_IDENTIFIER",
          "dataType": "UInt32",
          "access": "read",
          "required": false,
          "description": "Cumulative good-part counter from the machine."
        },
        {
          "key": "rejectCount",
          "role": "rejectCount",
          "direction": "machineToMes",
          "namespace": "machine",
          "identifier": "YOUR_REJECT_COUNT_IDENTIFIER",
          "dataType": "UInt32",
          "access": "read",
          "required": false,
          "description": "Cumulative reject counter from the machine."
        }
      ]
    }
  ],
  "metadata": {
    "environment": "commissioning",
    "writeApproval": "not-approved",
    "safetyBoundary": "MES must not implement or bypass a machine safety function"
  }
}
